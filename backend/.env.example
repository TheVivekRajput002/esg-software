# Backend Environment Variables (Render Web Service)

# Server Port (Render sets this automatically; set 5000 for local dev)
PORT=5000

# Node Environment ('production' for Render, 'development' for local)
NODE_ENV=production

# MongoDB Connection String (Atlas URI in production or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/esg_management?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure random strings)
JWT_SECRET=super_secret_jwt_key_esg_platform_2026
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_esg_platform_2026

# Token Lifespans
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
